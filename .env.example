# Copy to `.env` for Docker Compose. Replace the example values first.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
APP_ENCRYPTION_KEY=replace-with-a-stable-secret
COOKIE_SECURE=0
# Optional GitHub owner/repository used for version checks.
GITHUB_REPOSITORY=your-github-username/query-execute
UPDATE_CHECK_URL=https://api.github.com/repos/your-github-username/query-execute/releases/latest
UPDATE_RELEASES_URL=https://github.com/your-github-username/query-execute/releases/latest
